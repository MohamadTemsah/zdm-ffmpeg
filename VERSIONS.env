# Everything the build takes from outside, pinned. Nothing is fetched as "latest". Change a line here, and the hash with it.
FFMPEG_VERSION=9.0.2
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz
FFMPEG_SHA256=8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e
FFMPEG_SIG_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz.asc
# the FFmpeg release signing key (keys/ffmpeg-devel.asc); the fingerprint is what is trusted, not the file
FFMPEG_KEY_FPR=FCF986EA15E6E293A5644F10B4322F04D67658D8

LAME_VERSION=3.100
LAME_URL=https://sourceforge.net/projects/lame/files/lame/3.100/lame-3.100.tar.gz/download
LAME_SHA256=ddfe36cab873794038ae2c1210557ad34857a4b6bdc515785d1da9e175b1da1e

# the build's own number: raise it when only this repository changed (a new workflow, a new configure line)
BUILD_NUMBER=4
# one fixed date for everything that records a date (so two builds can be compared byte for byte)
SOURCE_DATE_EPOCH=1789000000
